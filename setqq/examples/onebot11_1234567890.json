{
  "_说明": "NapCat 的 OneBot 通道配置。文件名必须是 onebot11_<机器人QQ号>.json，放在 <NapCat目录>\\config\\ 下",
  "_注意": "token 必须与 DSH 插件配置里的 accessToken 完全一致；url 必须以 /ws 结尾",
  "network": {
    "httpServers": [],
    "httpClients": [],
    "websocketServers": [],
    "websocketClients": [
      {
        "name": "dsh-onebot",
        "enable": true,
        "url": "ws://127.0.0.1:8643/ws",
        "messagePostFormat": "array",
        "reportSelfMessage": false,
        "reconnectInterval": 3000,
        "token": "<accessToken>",
        "heartInterval": 30000
      }
    ]
  },
  "enableLocalFile2Url": true,
  "parseMultMsg": false,
  "musicSignUrl": ""
}
